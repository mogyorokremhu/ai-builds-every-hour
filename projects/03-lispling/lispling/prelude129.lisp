; Phase 129: hash-table helpers (put future prelude additions here)
(define (hash-copy h)
  (let ((c (make-hash)))
    (for-each (lambda (p) (hash-set! c (car p) (car (cdr p)))) (hash->list h))
    c))
(define (hash-map-values f h)
  (let ((c (make-hash)))
    (for-each (lambda (p) (hash-set! c (car p) (f (car (cdr p))))) (hash->list h))
    c))
(define (hash-filter pred h)
  (let ((c (make-hash)))
    (for-each (lambda (p) (if (pred (car p) (car (cdr p))) (hash-set! c (car p) (car (cdr p))) #f)) (hash->list h))
    c))
(define (hash-merge a b)
  (let ((c (hash-copy a)))
    (for-each (lambda (p) (hash-set! c (car p) (car (cdr p)))) (hash->list b))
    c))
(define (hash-fold f init h)
  (fold-left (lambda (acc p) (f acc (car p) (car (cdr p)))) init (hash->list h)))
(define (hash-invert h)
  (let ((c (make-hash)))
    (for-each (lambda (p) (hash-set! c (car (cdr p)) (car p))) (hash->list h))
    c))
; Phase 130: more hash-table helpers
(define (hash-pick h keys)
  (let ((c (make-hash)))
    (for-each (lambda (k) (if (hash-has-key? h k) (hash-set! c k (hash-ref h k)) #f)) keys)
    c))
(define (hash-omit h keys)
  (hash-filter (lambda (k v) (not (member k keys))) h))
(define (hash-any? pred h)
  (any (lambda (p) (pred (car p) (car (cdr p)))) (hash->list h)))
(define (hash-every? pred h)
  (every (lambda (p) (pred (car p) (car (cdr p)))) (hash->list h)))
(define (hash-from-pairs ps)
  (let ((c (make-hash)))
    (for-each (lambda (p) (hash-set! c (car p) (car (cdr p)))) ps)
    c))
(define (hash-count-by f xs)
  (let ((c (make-hash)))
    (for-each (lambda (x)
      (let ((k (f x)))
        (hash-set! c k (+ 1 (if (hash-has-key? c k) (hash-ref c k) 0))))) xs)
    c))
(define (hash-update! h k f default)
  (hash-set! h k (f (if (hash-has-key? h k) (hash-ref h k) default)))
  h)
(define (hash-group-by f xs)
  (let ((g (make-hash)))
    (for-each (lambda (x)
      (let ((k (f x)))
        (hash-set! g k (append (if (hash-has-key? g k) (hash-ref g k) '()) (list x))))) xs)
    g))
(define (hash-partition pred h)
  (let ((yes (make-hash)) (no (make-hash)))
    (for-each (lambda (k)
      (if (pred k (hash-ref h k))
          (hash-set! yes k (hash-ref h k))
          (hash-set! no k (hash-ref h k)))) (hash-keys h))
    (list yes no)))
(define (hash-find-key pred h)
  (let loop ((ks (hash-keys h)))
    (cond ((null? ks) #f)
          ((pred (car ks) (hash-ref h (car ks))) (car ks))
          (else (loop (cdr ks))))))
(define (string-words s) (filter (lambda (w) (> (string-length w) 0)) (string-split s " ")))
(define (string-chunk s n)
  (let loop ((i 0) (acc '()))
    (if (>= i (string-length s))
        (reverse acc)
        (loop (+ i n) (cons (substring s i (min (string-length s) (+ i n))) acc)))))
(define (string-center s w)
  (let* ((len (string-length s)) (pad (max 0 (- w len))) (l (quotient pad 2)))
    (string-append (string-repeat " " l) s (string-repeat " " (- pad l)))))
(define (string-vowel-count s)
  (length (filter (lambda (c) (member c (string->list "aeiouAEIOU"))) (string->list s))))
(define (string-char-freq s)
  (hash-count-by (lambda (c) c) (string->list s)))
