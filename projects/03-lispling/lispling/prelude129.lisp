; Phase 129: hash-table helpers (put future prelude additions here)
(define (hash-copy h)
  (let ((c (make-hash)))
    (for-each (lambda (p) (hash-set! c (car p) (car (cdr p)))) (hash->list h))
    c))
(define (hash-map-values f h)
  (let ((c (make-hash)))
    (for-each (lambda (p) (hash-set! c (car p) (f (car (cdr p))))) (hash->list h))
    c))
(define (hash-filter pred h)
  (let ((c (make-hash)))
    (for-each (lambda (p) (if (pred (car p) (car (cdr p))) (hash-set! c (car p) (car (cdr p))) #f)) (hash->list h))
    c))
(define (hash-merge a b)
  (let ((c (hash-copy a)))
    (for-each (lambda (p) (hash-set! c (car p) (car (cdr p)))) (hash->list b))
    c))
(define (hash-fold f init h)
  (fold-left (lambda (acc p) (f acc (car p) (car (cdr p)))) init (hash->list h)))
(define (hash-invert h)
  (let ((c (make-hash)))
    (for-each (lambda (p) (hash-set! c (car (cdr p)) (car p))) (hash->list h))
    c))
; Phase 130: more hash-table helpers
(define (hash-pick h keys)
  (let ((c (make-hash)))
    (for-each (lambda (k) (if (hash-has-key? h k) (hash-set! c k (hash-ref h k)) #f)) keys)
    c))
(define (hash-omit h keys)
  (hash-filter (lambda (k v) (not (member k keys))) h))
(define (hash-any? pred h)
  (any (lambda (p) (pred (car p) (car (cdr p)))) (hash->list h)))
(define (hash-every? pred h)
  (every (lambda (p) (pred (car p) (car (cdr p)))) (hash->list h)))
(define (hash-from-pairs ps)
  (let ((c (make-hash)))
    (for-each (lambda (p) (hash-set! c (car p) (car (cdr p)))) ps)
    c))
(define (hash-count-by f xs)
  (let ((c (make-hash)))
    (for-each (lambda (x)
      (let ((k (f x)))
        (hash-set! c k (+ 1 (if (hash-has-key? c k) (hash-ref c k) 0))))) xs)
    c))
(define (hash-update! h k f default)
  (hash-set! h k (f (if (hash-has-key? h k) (hash-ref h k) default)))
  h)
(define (hash-group-by f xs)
  (let ((g (make-hash)))
    (for-each (lambda (x)
      (let ((k (f x)))
        (hash-set! g k (append (if (hash-has-key? g k) (hash-ref g k) '()) (list x))))) xs)
    g))
(define (hash-partition pred h)
  (let ((yes (make-hash)) (no (make-hash)))
    (for-each (lambda (k)
      (if (pred k (hash-ref h k))
          (hash-set! yes k (hash-ref h k))
          (hash-set! no k (hash-ref h k)))) (hash-keys h))
    (list yes no)))
(define (hash-find-key pred h)
  (let loop ((ks (hash-keys h)))
    (cond ((null? ks) #f)
          ((pred (car ks) (hash-ref h (car ks))) (car ks))
          (else (loop (cdr ks))))))
(define (string-words s) (filter (lambda (w) (> (string-length w) 0)) (string-split s " ")))
(define (string-chunk s n)
  (let loop ((i 0) (acc '()))
    (if (>= i (string-length s))
        (reverse acc)
        (loop (+ i n) (cons (substring s i (min (string-length s) (+ i n))) acc)))))
(define (string-center s w)
  (let* ((len (string-length s)) (pad (max 0 (- w len))) (l (quotient pad 2)))
    (string-append (string-repeat " " l) s (string-repeat " " (- pad l)))))
(define (string-vowel-count s)
  (length (filter (lambda (c) (member c (string->list "aeiouAEIOU"))) (string->list s))))
(define (string-char-freq s)
  (hash-count-by (lambda (c) c) (string->list s)))
(define (list-rotate lst n)
  (let ((len (length lst)))
    (if (= len 0)
        lst
        (let ((k (modulo n len)))
          (append (list-tail lst k) (take lst k))))))
(define (list-adjacent-pairs lst)
  (if (or (null? lst) (null? (cdr lst)))
      '()
      (cons (list (car lst) (car (cdr lst))) (list-adjacent-pairs (cdr lst)))))
(define (list-dedupe-runs lst)
  (let loop ((l lst) (acc '()))
    (cond ((null? l) (reverse acc))
          ((and (pair? acc) (equal? (car acc) (car l))) (loop (cdr l) acc))
          (else (loop (cdr l) (cons (car l) acc))))))
(define (list-run-lengths lst)
  (let loop ((l lst) (acc '()))
    (cond ((null? l) (reverse acc))
          ((and (pair? acc) (equal? (car (car acc)) (car l)))
           (loop (cdr l) (cons (list (car (car acc)) (+ 1 (car (cdr (car acc))))) (cdr acc))))
          (else (loop (cdr l) (cons (list (car l) 1) acc))))))
(define (list-interleave a b)
  (cond ((null? a) b)
        ((null? b) a)
        (else (cons (car a) (cons (car b) (list-interleave (cdr a) (cdr b)))))))
(define (list-chunk lst n)
  (let loop ((l lst) (cur '()) (k 0) (acc '()))
    (cond ((null? l)
           (reverse (if (null? cur) acc (cons (reverse cur) acc))))
          ((= (+ k 1) n)
           (loop (cdr l) '() 0 (cons (reverse (cons (car l) cur)) acc)))
          (else (loop (cdr l) (cons (car l) cur) (+ k 1) acc)))))
(define (list-windows lst n)
  (if (< (length lst) n)
      '()
      (cons (take lst n) (list-windows (cdr lst) n))))
(define (list-split-at lst n)
  (list (take lst (min n (length lst))) (list-tail lst (min n (length lst)))))
(define (list-cartesian a b)
  (if (null? a)
      '()
      (append (map (lambda (y) (list (car a) y)) b) (list-cartesian (cdr a) b))))
(define (list-transpose rows)
  (if (or (null? rows) (null? (car rows)))
      '()
      (cons (map car rows) (list-transpose (map cdr rows)))))
(define (list-insert-at lst i x)
  (if (or (= i 0) (null? lst))
      (cons x lst)
      (cons (car lst) (list-insert-at (cdr lst) (- i 1) x))))
(define (list-remove-at lst i)
  (cond ((null? lst) '())
        ((= i 0) (cdr lst))
        (else (cons (car lst) (list-remove-at (cdr lst) (- i 1))))))
(define (list-intersperse lst sep)
  (cond ((null? lst) '())
        ((null? (cdr lst)) lst)
        (else (cons (car lst) (cons sep (list-intersperse (cdr lst) sep))))))
(define (list-subsets lst)
  (if (null? lst)
      (list '())
      (let ((rest (list-subsets (cdr lst))))
        (append rest (map (lambda (s) (cons (car lst) s)) rest)))))
(define (list-combinations lst k)
  (cond ((= k 0) (list '()))
        ((null? lst) '())
        (else (append (map (lambda (c) (cons (car lst) c))
                           (list-combinations (cdr lst) (- k 1)))
                      (list-combinations (cdr lst) k)))))
(define (list-permutations lst)
  (if (null? lst)
      (list '())
      (let loop ((i 0) (acc '()))
        (if (= i (length lst))
            acc
            (loop (+ i 1)
                  (append acc
                          (map (lambda (p) (cons (list-ref lst i) p))
                               (list-permutations (list-remove-at lst i)))))))))
