; --- phase 28: constructors, trees, splitting, alist helpers ---
(define (make-list n x)
  (let loop ((i 0) (acc '()))
    (if (>= i n) acc (loop (+ i 1) (cons x acc)))))
(define (list-tabulate n f)
  (let loop ((i (- n 1)) (acc '()))
    (if (< i 0) acc (loop (- i 1) (cons (f i) acc)))))
(define (vector-tabulate n f) (list->vector (list-tabulate n f)))
(define (product lst) (fold-left * 1 lst))
(define (split-at lst n) (list (take lst n) (drop lst n)))
(define (span pred lst) (list (take-while pred lst) (drop-while pred lst)))
(define (break pred lst) (span (lambda (x) (not (pred x))) lst))
(define (delete-at lst i)
  (append (take lst i) (drop lst (+ i 1))))
(define (insert-at lst i x)
  (append (take lst i) (cons x (drop lst i))))
(define (list-index-of x lst)
  (list-index (lambda (y) (equal? x y)) lst))
(define (tree-map f t)
  (cond ((null? t) '())
        ((pair? t) (cons (tree-map f (car t)) (tree-map f (cdr t))))
        (else (f t))))
(define (tree-leaves t)
  (cond ((null? t) '())
        ((pair? t) (append (tree-leaves (car t)) (tree-leaves (cdr t))))
        (else (list t))))
(define (tree-depth t)
  (if (pair? t)
      (+ 1 (fold-left max 0 (map tree-depth t)))
      0))
(define (alist-keys al) (map car al))
(define (alist-values al) (map cdr al))
(define (alist->hash al)
  (let ((h (make-hash)))
    (for-each (lambda (p) (hash-set! h (car p) (cdr p))) al)
    h))

; --- phase 29: search, statistics, vector in-place helpers ---
(define (find pred lst)
  (cond ((null? lst) #f)
        ((pred (car lst)) (car lst))
        (else (find pred (cdr lst)))))
(define (find-tail pred lst)
  (cond ((null? lst) #f)
        ((pred (car lst)) lst)
        (else (find-tail pred (cdr lst)))))
(define (list-max lst) (fold-left max (car lst) (cdr lst)))
(define (list-min lst) (fold-left min (car lst) (cdr lst)))
(define (average lst) (/ (apply + lst) (length lst)))
(define (median lst)
  (let* ((s (sort lst <)) (n (length s)) (h (quotient n 2)))
    (if (odd? n)
        (list-ref s h)
        (/ (+ (list-ref s (- h 1)) (list-ref s h)) 2))))
(define (mode lst)
  (let loop ((fs (frequencies lst)) (best #f) (bc 0))
    (cond ((null? fs) best)
          ((> (car (cdr (car fs))) bc) (loop (cdr fs) (car (car fs)) (car (cdr (car fs)))))
          (else (loop (cdr fs) best bc)))))
(define (flatmap f lst) (append-map f lst))
(define (vector-swap! v i j)
  (let ((t (vector-ref v i)))
    (vector-set! v i (vector-ref v j))
    (vector-set! v j t)))
(define (vector-reverse! v)
  (let loop ((i 0) (j (- (vector-length v) 1)))
    (if (< i j)
        (begin (vector-swap! v i j) (loop (+ i 1) (- j 1)))
        v)))
(define (reduce-right f init lst) (fold-right f init lst))
