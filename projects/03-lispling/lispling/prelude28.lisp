; --- phase 28: constructors, trees, splitting, alist helpers ---
(define (make-list n x)
  (let loop ((i 0) (acc '()))
    (if (>= i n) acc (loop (+ i 1) (cons x acc)))))
(define (list-tabulate n f)
  (let loop ((i (- n 1)) (acc '()))
    (if (< i 0) acc (loop (- i 1) (cons (f i) acc)))))
(define (vector-tabulate n f) (list->vector (list-tabulate n f)))
(define (product lst) (fold-left * 1 lst))
(define (split-at lst n) (list (take lst n) (drop lst n)))
(define (span pred lst) (list (take-while pred lst) (drop-while pred lst)))
(define (break pred lst) (span (lambda (x) (not (pred x))) lst))
(define (delete-at lst i)
  (append (take lst i) (drop lst (+ i 1))))
(define (insert-at lst i x)
  (append (take lst i) (cons x (drop lst i))))
(define (list-index-of x lst)
  (list-index (lambda (y) (equal? x y)) lst))
(define (tree-map f t)
  (cond ((null? t) '())
        ((pair? t) (cons (tree-map f (car t)) (tree-map f (cdr t))))
        (else (f t))))
(define (tree-leaves t)
  (cond ((null? t) '())
        ((pair? t) (append (tree-leaves (car t)) (tree-leaves (cdr t))))
        (else (list t))))
(define (tree-depth t)
  (if (pair? t)
      (+ 1 (fold-left max 0 (map tree-depth t)))
      0))
(define (alist-keys al) (map car al))
(define (alist-values al) (map cdr al))
(define (alist->hash al)
  (let ((h (make-hash)))
    (for-each (lambda (p) (hash-set! h (car p) (cdr p))) al)
    h))

; --- phase 29: search, statistics, vector in-place helpers ---
(define (find pred lst)
  (cond ((null? lst) #f)
        ((pred (car lst)) (car lst))
        (else (find pred (cdr lst)))))
(define (find-tail pred lst)
  (cond ((null? lst) #f)
        ((pred (car lst)) lst)
        (else (find-tail pred (cdr lst)))))
(define (list-max lst) (fold-left max (car lst) (cdr lst)))
(define (list-min lst) (fold-left min (car lst) (cdr lst)))
(define (average lst) (/ (apply + lst) (length lst)))
(define (median lst)
  (let* ((s (sort lst <)) (n (length s)) (h (quotient n 2)))
    (if (odd? n)
        (list-ref s h)
        (/ (+ (list-ref s (- h 1)) (list-ref s h)) 2))))
(define (mode lst)
  (let loop ((fs (frequencies lst)) (best #f) (bc 0))
    (cond ((null? fs) best)
          ((> (car (cdr (car fs))) bc) (loop (cdr fs) (car (car fs)) (car (cdr (car fs)))))
          (else (loop (cdr fs) best bc)))))
(define (flatmap f lst) (append-map f lst))
(define (vector-swap! v i j)
  (let ((t (vector-ref v i)))
    (vector-set! v i (vector-ref v j))
    (vector-set! v j t)))
(define (vector-reverse! v)
  (let loop ((i 0) (j (- (vector-length v) 1)))
    (if (< i j)
        (begin (vector-swap! v i j) (loop (+ i 1) (- j 1)))
        v)))
(define (reduce-right f init lst) (fold-right f init lst))
; --- phase 30: number theory + matrices ---
(define (prime? n)
  (and (> n 1)
       (let loop ((d 2))
         (cond ((> (* d d) n) #t)
               ((= (remainder n d) 0) #f)
               (else (loop (+ d 1)))))))
(define (primes-up-to n) (filter prime? (range 2 (+ n 1))))
(define (prime-factors n)
  (let loop ((n n) (d 2) (acc '()))
    (cond ((< n 2) (reverse acc))
          ((> (* d d) n) (reverse (cons n acc)))
          ((= (remainder n d) 0) (loop (quotient n d) d (cons d acc)))
          (else (loop n (+ d 1) acc)))))
(define (fib-list n)
  (let loop ((i 0) (a 0) (b 1) (acc '()))
    (if (= i n) (reverse acc) (loop (+ i 1) b (+ a b) (cons a acc)))))
(define (dot-product a b) (apply + (map * a b)))
(define (identity-matrix n)
  (list-tabulate n (lambda (i) (list-tabulate n (lambda (j) (if (= i j) 1 0))))))
(define (mat-mul a b)
  (let ((cols (transpose b)))
    (map (lambda (row) (map (lambda (c) (dot-product row c)) cols)) a)))
(define (mat-pow m k)
  (let loop ((k k) (base m) (acc (identity-matrix (length m))))
    (cond ((= k 0) acc)
          ((odd? k) (loop (quotient k 2) (mat-mul base base) (mat-mul acc base)))
          (else (loop (quotient k 2) (mat-mul base base) acc)))))
(define (factorial n) (let loop ((i 2) (acc 1)) (if (> i n) acc (loop (+ i 1) (* acc i)))))
(define (binomial n k)
  (if (or (< k 0) (> k n)) 0
      (let loop ((i 1) (acc 1))
        (if (> i k) acc (loop (+ i 1) (quotient (* acc (+ (- n k) i)) i))))))
(define (divisors n) (filter (lambda (d) (= (remainder n d) 0)) (range 1 (+ n 1))))
(define (perfect? n) (and (> n 1) (= (- (apply + (divisors n)) n) n)))
(define (totient n) (length (filter (lambda (k) (= (gcd n k) 1)) (range 1 (+ n 1)))))
(define (mod-expt b e m)
  (let loop ((b (modulo b m)) (e e) (acc 1))
    (cond ((= e 0) (modulo acc m))
          ((odd? e) (loop (modulo (* b b) m) (quotient e 2) (modulo (* acc b) m)))
          (else (loop (modulo (* b b) m) (quotient e 2) acc)))))
(define (digits->number ds) (fold-left (lambda (acc d) (+ (* acc 10) d)) 0 ds))
(define (collatz-length n)
  (let loop ((n n) (steps 0))
    (cond ((= n 1) steps)
          ((even? n) (loop (quotient n 2) (+ steps 1)))
          (else (loop (+ (* 3 n) 1) (+ steps 1))))))
(define (gcd-list xs) (fold-left gcd 0 xs))
(define (lcm-list xs) (fold-left lcm 1 xs))
(define (digit-sum n) (let loop ((n n) (acc 0)) (if (= n 0) acc (loop (quotient n 10) (+ acc (remainder n 10))))))
(define (reverse-number n) (let loop ((n n) (acc 0)) (if (= n 0) acc (loop (quotient n 10) (+ (* acc 10) (remainder n 10))))))
(define (palindrome-number? n) (= n (reverse-number n)))
(define (triangular n) (quotient (* n (+ n 1)) 2))
(define (isqrt n) (let loop ((x n)) (let ((y (quotient (+ x (quotient n (if (= x 0) 1 x))) 2))) (if (>= y x) x (loop y)))))
(define (perfect-square? n) (and (>= n 0) (= (* (isqrt n) (isqrt n)) n)))
(define (pascal-row n) (map (lambda (k) (binomial n k)) (range 0 (+ n 1))))
(define (happy? n)
  (let loop ((n n) (seen '()))
    (cond ((= n 1) #t)
          ((memq n seen) #f)
          (else (loop (apply + (map (lambda (d) (* d d)) (digits n))) (cons n seen))))))
(define (sliding-window xs n)
  (if (< (length xs) n) '() (cons (take xs n) (sliding-window (cdr xs) n))))
(define (take-every xs n)
  (let loop ((xs xs) (i 0) (acc '()))
    (cond ((null? xs) (reverse acc))
          ((= (remainder i n) 0) (loop (cdr xs) (+ i 1) (cons (car xs) acc)))
          (else (loop (cdr xs) (+ i 1) acc)))))
(define (rle xs)
  (if (null? xs) '()
      (let loop ((cur (car xs)) (n 1) (rest (cdr xs)) (acc '()))
        (cond ((null? rest) (reverse (cons (list cur n) acc)))
              ((equal? (car rest) cur) (loop cur (+ n 1) (cdr rest) acc))
              (else (loop (car rest) 1 (cdr rest) (cons (list cur n) acc)))))))
(define (rle-decode pairs)
  (append-map (lambda (p) (make-list (car (cdr p)) (car p))) pairs))
(define (dedupe-adjacent xs) (map car (rle xs)))
(define (scan-left f init xs)
  (let loop ((acc init) (xs xs) (out (list init)))
    (if (null? xs) (reverse out)
        (let ((v (f acc (car xs)))) (loop v (cdr xs) (cons v out))))))
(define (prefix-sums xs) (cdr (scan-left + 0 xs)))
(define (unfold f seed n)
  (let loop ((s seed) (i 0) (acc '()))
    (if (= i n) (reverse acc) (loop (f s) (+ i 1) (cons s acc)))))
(define (rotate-left xs n)
  (if (null? xs) '()
      (let ((k (modulo n (length xs)))) (append (list-tail xs k) (take xs k)))))
(define (rotate-right xs n) (rotate-left xs (- (length xs) (modulo n (max 1 (length xs))))))
(define (index-of xs x)
  (let loop ((xs xs) (i 0))
    (cond ((null? xs) -1) ((equal? (car xs) x) i) (else (loop (cdr xs) (+ i 1))))))
(define (last-index-of xs x)
  (let loop ((xs xs) (i 0) (found -1))
    (cond ((null? xs) found)
          ((equal? (car xs) x) (loop (cdr xs) (+ i 1) i))
          (else (loop (cdr xs) (+ i 1) found)))))
(define (zip-with f a b)
  (if (or (null? a) (null? b)) '() (cons (f (car a) (car b)) (zip-with f (cdr a) (cdr b)))))
(define (range-step start stop step)
  (let loop ((i start) (acc '()))
    (if (if (> step 0) (>= i stop) (<= i stop)) (reverse acc) (loop (+ i step) (cons i acc)))))
(define (flatten-depth xs d)
  (cond ((null? xs) '())
        ((and (pair? (car xs)) (> d 0)) (append (flatten-depth (car xs) (- d 1)) (flatten-depth (cdr xs) d)))
        (else (cons (car xs) (flatten-depth (cdr xs) d)))))
(define (adjacent-pairs xs)
  (if (or (null? xs) (null? (cdr xs))) '()
      (cons (list (car xs) (car (cdr xs))) (adjacent-pairs (cdr xs)))))
(define (last-n xs n)
  (let ((len (length xs))) (if (<= len n) xs (list-tail xs (- len n)))))
(define (drop-last xs n)
  (let ((len (length xs))) (if (<= len n) '() (take xs (- len n)))))
(define (argmax xs)
  (if (null? xs) -1
      (let loop ((rest (cdr xs)) (i 1) (best 0) (bv (car xs)))
        (cond ((null? rest) best)
              ((> (car rest) bv) (loop (cdr rest) (+ i 1) i (car rest)))
              (else (loop (cdr rest) (+ i 1) best bv))))))
(define (running-max xs)
  (if (null? xs) '()
      (cdr (scan-left (lambda (a b) (if (> b a) b a)) (car xs) xs))))
(define (interpose sep xs)
  (cond ((null? xs) '())
        ((null? (cdr xs)) xs)
        (else (cons (car xs) (cons sep (interpose sep (cdr xs)))))))
(define (map-indexed f xs)
  (let loop ((rest xs) (i 0) (acc '()))
    (if (null? rest) (reverse acc)
        (loop (cdr rest) (+ i 1) (cons (f i (car rest)) acc)))))
(define (replicate n x)
  (let loop ((i 0) (acc '()))
    (if (>= i n) acc (loop (+ i 1) (cons x acc)))))
(define (remove-nth xs n)
  (cond ((null? xs) '())
        ((= n 0) (cdr xs))
        (else (cons (car xs) (remove-nth (cdr xs) (- n 1))))))
(define (all-equal? xs)
  (or (null? xs)
      (let loop ((rest (cdr xs)))
        (cond ((null? rest) #t)
              ((equal? (car rest) (car xs)) (loop (cdr rest)))
              (else #f)))))
(define (chunk-by f xs)
  (if (null? xs) '()
      (let loop ((rest (cdr xs)) (cur (list (car xs))) (key (f (car xs))) (acc '()))
        (cond ((null? rest) (reverse (cons (reverse cur) acc)))
              ((equal? (f (car rest)) key) (loop (cdr rest) (cons (car rest) cur) key acc))
              (else (loop (cdr rest) (list (car rest)) (f (car rest)) (cons (reverse cur) acc)))))))
(define (cumulative-sum xs) (prefix-sums xs))
(define (differences xs)
  (if (or (null? xs) (null? (cdr xs))) '()
      (cons (- (car (cdr xs)) (car xs)) (differences (cdr xs)))))
(define (take-last xs n)
  (let ((len (length xs)))
    (if (>= n len) xs
        (let loop ((rest xs) (k (- len n)))
          (if (= k 0) rest (loop (cdr rest) (- k 1)))))))
(define (split-on x xs)
  (let loop ((rest xs) (cur '()) (acc '()))
    (cond ((null? rest) (reverse (cons (reverse cur) acc)))
          ((equal? (car rest) x) (loop (cdr rest) '() (cons (reverse cur) acc)))
          (else (loop (cdr rest) (cons (car rest) cur) acc)))))
(define (min-max-list xs)
  (let loop ((rest (cdr xs)) (lo (car xs)) (hi (car xs)))
    (cond ((null? rest) (list lo hi))
          (else (loop (cdr rest)
                      (if (< (car rest) lo) (car rest) lo)
                      (if (> (car rest) hi) (car rest) hi))))))
(define (flatten-once xss)
  (if (null? xss) '() (append (car xss) (flatten-once (cdr xss)))))
(define (zip3 a b c)
  (if (or (null? a) (null? b) (null? c)) '()
      (cons (list (car a) (car b) (car c)) (zip3 (cdr a) (cdr b) (cdr c)))))
