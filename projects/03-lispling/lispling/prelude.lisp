; Standard library written in Lispling itself.

(define-macro (when test body)
  `(if ,test ,body))
(define-macro (unless test body)
  `(if ,test '() ,body))
(define-macro (swap! a b)
  `(let ((%tmp ,a)) (set! ,a ,b) (set! ,b %tmp)))
(define-macro (while test body)
  `(let %loop () (if ,test (begin ,body (%loop)) '())))

(define (identity x) x)
(define (inc n) (+ n 1))
(define (dec n) (- n 1))
(define (zero? n) (= n 0))
(define (even? n) (= (mod n 2) 0))
(define (odd? n) (not (even? n)))
(define (second l) (car (cdr l)))
(define (third l) (car (cdr (cdr l))))
(define (reverse l)
  (let loop ((l l) (acc '()))
    (if (null? l) acc (loop (cdr l) (cons (car l) acc)))))
(define (range a b)
  (let loop ((i (- b 1)) (acc '()))
    (if (< i a) acc (loop (- i 1) (cons i acc)))))
(define (take l n)
  (if (or (= n 0) (null? l)) '() (cons (car l) (take (cdr l) (- n 1)))))
(define (drop l n)
  (if (or (= n 0) (null? l)) l (drop (cdr l) (- n 1))))
(define (member x l)
  (cond ((null? l) #f) ((equal? x (car l)) l) (else (member x (cdr l)))))
(define (last l)
  (if (null? (cdr l)) (car l) (last (cdr l))))
(define (flatten l)
  (cond ((null? l) '())
        ((list? (car l)) (append (flatten (car l)) (flatten (cdr l))))
        (else (cons (car l) (flatten (cdr l))))))
(define (sum l) (reduce + 0 l))
(define (compose f g) (lambda (x) (f (g x))))

; --- Lazy evaluation: promises and streams (memoised closures) ---
(define (%make-promise thunk)
  (let ((done #f) (val '()))
    (lambda ()
      (if done
          val
          (let ((v (thunk)))
            (if done
                val
                (begin (set! done #t) (set! val v) v)))))))
(define-macro (delay e)
  `(%make-promise (lambda () ,e)))
(define (force p) (p))
(define-macro (cons-stream a b)
  `(cons ,a (delay ,b)))
(define (stream-car s) (car s))
(define (stream-cdr s) (force (cdr s)))
(define (stream-take s n)
  (if (or (= n 0) (null? s))
      '()
      (cons (stream-car s) (stream-take (stream-cdr s) (- n 1)))))
(define (stream-ref s n)
  (if (= n 0) (stream-car s) (stream-ref (stream-cdr s) (- n 1))))
(define (stream-map f s)
  (if (null? s) '() (cons-stream (f (stream-car s)) (stream-map f (stream-cdr s)))))
(define (stream-filter p s)
  (cond ((null? s) '())
        ((p (stream-car s)) (cons-stream (stream-car s) (stream-filter p (stream-cdr s))))
        (else (stream-filter p (stream-cdr s)))))
(define (integers-from n) (cons-stream n (integers-from (+ n 1))))

; --- Phase 19: sorting and list utilities -------------------------------
(define (list-tail l n)
  (if (= n 0) l
      (if (null? l) (error "list-tail: index out of range") (list-tail (cdr l) (- n 1)))))
(define (list-ref l n)
  (if (null? l) (error "list-ref: index out of range")
      (if (= n 0) (car l) (list-ref (cdr l) (- n 1)))))
(define (remove pred l) (filter (lambda (x) (not (pred x))) l))
(define (delete x l) (remove (lambda (y) (equal? x y)) l))
(define (partition pred l)
  (let loop ((l l) (yes '()) (no '()))
    (if (null? l) (list (reverse yes) (reverse no))
        (if (pred (car l))
            (loop (cdr l) (cons (car l) yes) no)
            (loop (cdr l) yes (cons (car l) no))))))
(define (list-index pred l)
  (let loop ((l l) (i 0))
    (if (null? l) -1 (if (pred (car l)) i (loop (cdr l) (+ i 1))))))
(define (%merge less a b)
  (let loop ((a a) (b b) (acc '()))
    (if (null? a) (append (reverse acc) b)
        (if (null? b) (append (reverse acc) a)
            (if (less (car b) (car a))
                (loop a (cdr b) (cons (car b) acc))
                (loop (cdr a) b (cons (car a) acc)))))))
(define (sort l less)
  (let ((n (length l)))
    (if (< n 2) l
        (let ((half (/ (- n (mod n 2)) 2)))
          (%merge less (sort (take l half) less) (sort (drop l half) less))))))
(define (vector-map f v) (list->vector (map f (vector->list v))))
(define (vector-for-each f v) (for-each f (vector->list v)))
(define (vector-sort v less) (list->vector (sort (vector->list v) less)))
(define (fold-left f init l)
  (if (null? l) init (fold-left f (f init (car l)) (cdr l))))
(define (fold-right f init l)
  (if (null? l) init (f (car l) (fold-right f init (cdr l)))))
(define (append-map f l) (apply append (map f l)))
(define (iota n) (range 0 n))
(define (iota-from n start) (range start (+ start n)))
(define (any pred l)
  (if (null? l) #f (or (pred (car l)) (any pred (cdr l)))))
(define (every pred l)
  (if (null? l) #t (if (pred (car l)) (every pred (cdr l)) #f)))
(define (count pred l)
  (fold-left (lambda (n x) (if (pred x) (+ n 1) n)) 0 l))
(define (zip a b)
  (if (or (null? a) (null? b)) '()
      (cons (list (car a) (car b)) (zip (cdr a) (cdr b)))))
(define (remove-duplicates l)
  (let loop ((l l) (seen '()))
    (if (null? l) (reverse seen)
        (loop (cdr l) (if (member (car l) seen) seen (cons (car l) seen))))))
(define (take-while pred l)
  (if (or (null? l) (not (pred (car l)))) '()
      (cons (car l) (take-while pred (cdr l)))))
(define (drop-while pred l)
  (if (or (null? l) (not (pred (car l)))) l (drop-while pred (cdr l))))
(define (filter-map f l)
  (let loop ((l l) (acc '()))
    (if (null? l) (reverse acc)
        (let ((v (f (car l))))
          (loop (cdr l) (if v (cons v acc) acc))))))
(define (list-set l k v)
  (if (= k 0) (cons v (cdr l)) (cons (car l) (list-set (cdr l) (- k 1) v))))
(define (last-pair l)
  (if (null? (cdr l)) l (last-pair (cdr l))))
(define (alist-set al k v)
  (cond ((null? al) (list (list k v)))
        ((equal? (car (car al)) k) (cons (list k v) (cdr al)))
        (else (cons (car al) (alist-set (cdr al) k v)))))
(define (alist-ref al k default)
  (let ((e (assoc k al))) (if e (car (cdr e)) default)))
(define (hash-update! h k f default)
  (hash-set! h k (f (hash-ref h k default))))
(define (group-by f l)
  (let ((h (make-hash)))
    (for-each (lambda (x) (hash-update! h (f x) (lambda (v) (append v (list x))) '())) l)
    (hash->list h)))
(define (memq x l) (member x l))
(define (square x) (* x x))
(define (cube x) (* x x x))
(define (exact-integer-sqrt n)
  (let loop ((r 0)) (if (> (* (+ r 1) (+ r 1)) n) r (loop (+ r 1)))))
(define (list-copy l) (map (lambda (x) x) l))
(define (delete-duplicates l) (remove-duplicates l))
(define (digits n) (map string->number (string->list (number->string n))))
(define (butlast l) (if (or (null? l) (null? (cdr l))) '() (cons (car l) (butlast (cdr l)))))
(define (curry f . args) (lambda rest (apply f (append args rest))))
(define partial curry)
(define (constantly v) (lambda args v))
(define (complement f) (lambda args (not (apply f args))))
(define (juxt . fs) (lambda args (map (lambda (f) (apply f args)) fs)))
(define (compose* . fs)
  (if (null? fs)
      identity
      (lambda args
        (let loop ((rev (reverse fs)) (acc #f) (first #t))
          (cond ((null? rev) acc)
                (first (loop (cdr rev) (apply (car rev) args) #f))
                (else (loop (cdr rev) ((car rev) acc) #f)))))))
(define (flip f) (lambda (a b) (f b a)))
(define (max-by f l)
  (fold-left (lambda (best x) (if (> (f x) (f best)) x best)) (car l) (cdr l)))
(define (min-by f l)
  (fold-left (lambda (best x) (if (< (f x) (f best)) x best)) (car l) (cdr l)))
(define (interleave a b)
  (if (or (null? a) (null? b)) '() (cons (car a) (cons (car b) (interleave (cdr a) (cdr b))))))
(define (transpose m) (if (or (null? m) (null? (car m))) '() (cons (map car m) (transpose (map cdr m)))))
(define (chunk n l)
  (if (null? l) '() (cons (take l (min n (length l))) (chunk n (drop l (min n (length l)))))))
(define (frequencies l)
  (let ((h (make-hash)))
    (for-each (lambda (x) (hash-update! h x (lambda (v) (+ v 1)) 0)) l)
    (hash->list h)))
(define (string-map f s) (list->string (map f (string->list s))))
(define (string-for-each f s) (for-each f (string->list s)))
(define (string-take s n) (substring s 0 n))
(define (string-drop s n) (substring s n))
(define (string-filter pred s) (list->string (filter pred (string->list s))))
(define (string-capitalize s)
  (if (= (string-length s) 0) s
      (string-append (string-upcase (substring s 0 1)) (string-downcase (substring s 1)))))
(define (palindrome? s)
  (let ((t (string-filter char-alphabetic? (string-downcase s))))
    (string=? t (string-reverse t))))
(define (caesar-shift n s)
  (string-map
    (lambda (c)
      (cond ((char-upper-case? c) (integer->char (+ 65 (modulo (+ (- (char->integer c) 65) n) 26))))
            ((char-lower-case? c) (integer->char (+ 97 (modulo (+ (- (char->integer c) 97) n) 26))))
            (else c)))
    s))
(define (word-count s) (length (filter (lambda (w) (> (string-length w) 0)) (string-split s " "))))

; Phase 27: set operations on lists, combinatorics, vector utilities
(define (list-union a b)
  (append a (filter (lambda (x) (not (member x a))) (remove-duplicates b))))
(define (list-intersection a b)
  (filter (lambda (x) (member x b)) (remove-duplicates a)))
(define (list-difference a b)
  (filter (lambda (x) (not (member x b))) (remove-duplicates a)))
(define (subset? a b) (every (lambda (x) (member x b)) a))
(define (take-right lst n) (drop lst (- (length lst) n)))
(define (drop-right lst n) (take lst (- (length lst) n)))
(define (rotate lst n)
  (if (null? lst) lst
      (let ((k (modulo n (length lst))))
        (append (drop lst k) (take lst k)))))
(define (pairwise lst)
  (if (or (null? lst) (null? (cdr lst))) '()
      (cons (list (car lst) (car (cdr lst))) (pairwise (cdr lst)))))
(define (cartesian-product a b)
  (append-map (lambda (x) (map (lambda (y) (list x y)) b)) a))
(define (power-set lst)
  (if (null? lst) '(())
      (let ((rest (power-set (cdr lst))))
        (append rest (map (lambda (s) (cons (car lst) s)) rest)))))
(define (combinations lst k)
  (cond ((= k 0) '(()))
        ((null? lst) '())
        (else (append (map (lambda (c) (cons (car lst) c)) (combinations (cdr lst) (- k 1)))
                      (combinations (cdr lst) k)))))
(define (permutations lst)
  (if (null? lst) '(())
      (append-map
        (lambda (x)
          (map (lambda (p) (cons x p)) (permutations (delete x lst))))
        lst)))
(define (subvector v start end) (list->vector (take (drop (vector->list v) start) (- end start))))
(define (vector-append . vs) (list->vector (apply append (map vector->list vs))))
(define (vector-reverse v) (list->vector (reverse (vector->list v))))
(define (vector-count pred v) (count pred (vector->list v)))
(define (vector-index pred v)
  (let loop ((i 0))
    (cond ((>= i (vector-length v)) #f)
          ((pred (vector-ref v i)) i)
          (else (loop (+ i 1))))))
(define (vector-binary-search v target)
  (let loop ((lo 0) (hi (- (vector-length v) 1)))
    (if (> lo hi) #f
        (let* ((mid (quotient (+ lo hi) 2)) (x (vector-ref v mid)))
          (cond ((= x target) mid)
                ((< x target) (loop (+ mid 1) hi))
                (else (loop lo (- mid 1))))))))
