; Statistics helpers (phase 55)
(define (range-of xs) (- (apply max xs) (apply min xs)))
(define (variance xs) (let ((m (/ (apply + xs) (length xs)))) (/ (apply + (map (lambda (x) (* (- x m) (- x m))) xs)) (length xs))))
(define (mean-absolute-deviation xs) (let ((m (/ (apply + xs) (length xs)))) (/ (apply + (map (lambda (x) (abs (- x m))) xs)) (length xs))))
(define (cumulative-product xs) (cdr (scan-left * 1 xs)))
; Phase 56: more stats / sequence helpers
(define (std-dev xs) (sqrt (variance xs)))
(define (covariance xs ys) (let ((mx (/ (apply + xs) (length xs))) (my (/ (apply + ys) (length ys)))) (/ (apply + (map (lambda (x y) (* (- x mx) (- y my))) xs ys)) (length xs))))
(define (weighted-average xs ws) (/ (apply + (map * xs ws)) (apply + ws)))
(define (cumulative-max xs) (if (null? xs) '() (cdr (scan-left max (car xs) xs))))
(define (cumulative-min xs) (if (null? xs) '() (cdr (scan-left min (car xs) xs))))
; Phase 57: correlation, normalization, moving averages
(define (correlation xs ys) (/ (covariance xs ys) (* (std-dev xs) (std-dev ys))))
(define (z-scores xs) (let ((m (/ (apply + xs) (length xs))) (s (std-dev xs))) (map (lambda (x) (/ (- x m) s)) xs)))
(define (min-max-normalize xs) (let ((lo (apply min xs)) (hi (apply max xs))) (map (lambda (x) (/ (- x lo) (- hi lo))) xs)))
(define (moving-average xs n) (map (lambda (w) (/ (apply + w) n)) (sliding-window xs n)))
; Phase 58: percentiles, ranges, ranks
(define (quantile-sorted s p) (list-ref s (min (- (length s) 1) (inexact->exact (floor (* p (- (length s) 1)))))))
(define (percentile xs p) (quantile-sorted (sort xs <) p))
(define (interquartile-range xs) (let ((s (sort xs <))) (- (quantile-sorted s 0.75) (quantile-sorted s 0.25))))
(define (ranks xs) (let ((s (sort xs <))) (map (lambda (x) (+ 1 (index-of s x))) xs)))
(define (normalize-sum xs) (let ((t (apply + xs))) (map (lambda (x) (/ x t)) xs)))
; Phase 59: means and trimmed statistics
(define (root-mean-square xs) (sqrt (/ (apply + (map (lambda (x) (* x x)) xs)) (length xs))))
(define (harmonic-mean xs) (/ (length xs) (apply + (map (lambda (x) (/ 1 x)) xs))))
(define (geometric-mean xs) (expt (apply * xs) (/ 1 (length xs))))
(define (trimmed-mean xs k) (let* ((s (sort xs <)) (m (take-last (drop-last s k) (- (length s) (* 2 k))))) (/ (apply + m) (length m))))
; Phase 60: dispersion helpers
(define (sum-squared-deviations xs) (* (variance xs) (length xs)))
(define (coefficient-of-variation xs) (/ (std-dev xs) (/ (apply + xs) (length xs))))
(define (standard-error xs) (/ (std-dev xs) (sqrt (length xs))))
(define (midrange-of xs) (/ (+ (apply min xs) (apply max xs)) 2))
; Phase 61: absolute deviations, skewness and weighted spread
(define (sum-absolute-deviations xs) (let ((m (/ (apply + xs) (length xs)))) (apply + (map (lambda (x) (abs (- x m))) xs))))
(define (pearson-skewness xs) (/ (* 3 (- (/ (apply + xs) (length xs)) (median xs))) (std-dev xs)))
(define (median-absolute-deviation xs) (let ((m (median xs))) (median (map (lambda (x) (abs (- x m))) xs))))
(define (weighted-variance xs ws) (let ((m (weighted-average xs ws))) (/ (apply + (map (lambda (x w) (* w (* (- x m) (- x m)))) xs ws)) (apply + ws))))
; Phase 62: higher moments and running means
(define (skewness xs) (let ((m (/ (apply + xs) (length xs))) (s (std-dev xs))) (/ (/ (apply + (map (lambda (x) (expt (- x m) 3)) xs)) (length xs)) (* s s s))))
(define (excess-kurtosis xs) (let ((m (/ (apply + xs) (length xs))) (v (variance xs))) (- (/ (/ (apply + (map (lambda (x) (expt (- x m) 4)) xs)) (length xs)) (* v v)) 3)))
(define (kurtosis xs) (+ 3 (excess-kurtosis xs)))
(define (cumulative-mean xs) (map (lambda (s i) (/ s i)) (cumulative-sum xs) (list-range-inclusive 1 (length xs))))
; Phase 63: error metrics and running minimum
(define (mean-absolute-error xs ys) (/ (apply + (map (lambda (x y) (abs (- x y))) xs ys)) (length xs)))
(define (mean-squared-error xs ys) (/ (apply + (map (lambda (x y) (* (- x y) (- x y))) xs ys)) (length xs)))
(define (root-mean-squared-error xs ys) (sqrt (mean-squared-error xs ys)))
(define (running-min xs) (if (null? xs) '() (let loop ((rest (cdr xs)) (m (car xs)) (acc (list (car xs)))) (if (null? rest) (reverse acc) (let ((n (min m (car rest)))) (loop (cdr rest) n (cons n acc)))))))
; Phase 64: simple linear regression and running range
(define (linear-slope xs ys) (/ (covariance xs ys) (variance xs)))
(define (linear-intercept xs ys) (- (/ (apply + ys) (length ys)) (* (linear-slope xs ys) (/ (apply + xs) (length xs)))))
(define (r-squared xs ys) (let ((r (correlation xs ys))) (* r r)))
(define (running-max-min-range xs) (map - (running-max xs) (running-min xs)))
; Phase 65: regression prediction, residuals and error extremes
(define (predict-linear xs ys x) (+ (linear-intercept xs ys) (* (linear-slope xs ys) x)))
(define (residuals xs ys) (let ((a (linear-intercept xs ys)) (b (linear-slope xs ys))) (map (lambda (x y) (- y (+ a (* b x)))) xs ys)))
(define (max-error xs ys) (apply max (map (lambda (x y) (abs (- x y))) xs ys)))
(define (mean-absolute-percentage-error xs ys) (* 100 (/ (apply + (map (lambda (x y) (abs (/ (- x y) x))) xs ys)) (length xs))))
; Phase 66: forecast bias and scale-free error metrics
(define (mean-bias xs ys) (/ (apply + (map (lambda (x y) (- y x)) xs ys)) (length xs)))
(define (smape xs ys) (* 100 (/ (apply + (map (lambda (x y) (/ (* 2 (abs (- x y))) (+ (abs x) (abs y)))) xs ys)) (length xs))))
(define (normalized-rmse xs ys) (/ (root-mean-squared-error xs ys) (- (apply max xs) (apply min xs))))
(define (cumulative-error xs ys) (cumulative-sum (map (lambda (x y) (- y x)) xs ys)))
; Phase 67: weighted means, exponential smoothing, relative and median errors
(define (weighted-mean xs ws) (/ (apply + (map * xs ws)) (apply + ws)))
(define (exponential-moving-average xs alpha) (if (null? xs) '() (let loop ((rest (cdr xs)) (e (car xs)) (acc (list (car xs)))) (if (null? rest) (reverse acc) (let ((n (+ (* alpha (car rest)) (* (- 1 alpha) e)))) (loop (cdr rest) n (cons n acc)))))))
(define (relative-error x y) (abs (/ (- y x) x)))
(define (median-absolute-error xs ys) (median (map (lambda (x y) (abs (- x y))) xs ys)))
; Phase 68: rolling window aggregates
(define (rolling-sum xs n) (map (lambda (w) (apply + w)) (sliding-window xs n)))
(define (rolling-max xs n) (map (lambda (w) (apply max w)) (sliding-window xs n)))
(define (rolling-min xs n) (map (lambda (w) (apply min w)) (sliding-window xs n)))
(define (rolling-range xs n) (map (lambda (w) (- (apply max w) (apply min w))) (sliding-window xs n)))
; Phase 69: rolling mean/median/variance/product
(define (rolling-mean xs n) (map (lambda (w) (/ (apply + w) (length w))) (sliding-window xs n)))
(define (rolling-median xs n) (map median (sliding-window xs n)))
(define (rolling-variance xs n) (map variance (sliding-window xs n)))
(define (rolling-product xs n) (map (lambda (w) (apply * w)) (sliding-window xs n)))
; Phase 70: more rolling-window aggregates
(define (rolling-std-dev xs n) (map std-dev (sliding-window xs n)))
(define (rolling-sum-squares xs n) (map (lambda (w) (apply + (map (lambda (x) (* x x)) w))) (sliding-window xs n)))
(define (rolling-geometric-mean xs n) (map geometric-mean (sliding-window xs n)))
(define (rolling-midrange xs n) (map midrange-of (sliding-window xs n)))
; Phase 71: rolling argmax/argmin/count/change
(define (list-argbest better? w) (let loop ((rest (cdr w)) (i 1) (bi 0) (bv (car w))) (cond ((null? rest) bi) ((better? (car rest) bv) (loop (cdr rest) (+ i 1) i (car rest))) (else (loop (cdr rest) (+ i 1) bi bv)))))
(define (rolling-argmax xs n) (map (lambda (w) (list-argbest > w)) (sliding-window xs n)))
(define (rolling-argmin xs n) (map (lambda (w) (list-argbest < w)) (sliding-window xs n)))
(define (rolling-count-if pred xs n) (map (lambda (w) (length (filter pred w))) (sliding-window xs n)))
(define (rolling-change xs n) (map (lambda (w) (- (car (reverse w)) (car w))) (sliding-window xs n)))
; Phase 72: rolling percent change / MAD / last z-score / distinct count
(define (rolling-percent-change xs n) (map (lambda (w) (* 100 (/ (- (car (reverse w)) (car w)) (car w)))) (sliding-window xs n)))
(define (rolling-mad xs n) (map mean-absolute-deviation (sliding-window xs n)))
(define (rolling-zscore-last xs n) (map (lambda (w) (let ((s (std-dev w))) (if (= s 0) 0 (/ (- (car (reverse w)) (/ (apply + w) (length w))) s)))) (sliding-window xs n)))
(define (rolling-distinct xs n) (map (lambda (w) (length (let loop ((r w) (seen '())) (cond ((null? r) seen) ((member (car r) seen) (loop (cdr r) seen)) (else (loop (cdr r) (cons (car r) seen))))))) (sliding-window xs n)))
