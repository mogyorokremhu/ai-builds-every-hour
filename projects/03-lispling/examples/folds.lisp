; Folds and list utilities (prelude, phase 20)
(display (fold-left - 0 '(1 2 3)))
(display (fold-right cons '() '(1 2 3)))
(display (append-map (lambda (x) (list x x)) '(a b c)))
(display (iota 5) (iota-from 3 10))
(display (any even? '(1 3 4)) (every odd? '(1 3 5)))
(display (count even? (iota 10)))
(display (zip '(1 2 3) '(a b c)))
(display (remove-duplicates '(1 2 1 3 2 4)))
