; Search, statistics, in-place vector helpers (prelude, phase 29)
(display (find even? '(1 3 4 5)))
(display (find-tail even? '(1 3 4 5)))
(display (list-max '(3 9 2)))
(display (list-min '(3 9 2)))
(display (average '(1 2 3 4)))
(display (median '(5 1 3)))
(display (median '(4 1 3 2)))
(display (mode '(1 2 2 3 3 3 1)))
(define v (vector 1 2 3 4))
(vector-reverse! v)
(display v)
